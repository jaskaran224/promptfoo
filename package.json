{
  "name": "banking-chatbot-promptfoo-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run start",
    "start": "npm run build && node dist/src/server.js",
    "cli": "npm run build && node dist/src/cli.js",
    "build": "tsc",
    "preredteam": "npm run build && node -e \"require('node:fs').mkdirSync('evaluations', { recursive: true })\"",
    "redteam": "promptfoo redteam run -c promptfooconfig.redteam.yaml --remote --output redteam-latest.json"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "promptfoo": "^0.120.8",
    "typescript": "^5.9.2"
  }
}

